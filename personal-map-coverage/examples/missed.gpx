<?xml version="1.0" encoding="UTF-8"?>
<!-- Illustrative GET /api/export/gpx?aoiId=… output. Fictional coordinates.
     One <trk>; one <trkseg> per clipped segment of every MISSED way (exclusion vertices already removed).
     Filename: <AOI name with spaces → underscores>_missed.gpx -->
<gpx version="1.1" creator="path-coverage" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>Example Common - Missed Segments</name>
    <trkseg>
      <trkpt lat="0.0005" lon="0.004"></trkpt>
      <trkpt lat="0.0011" lon="0.0042"></trkpt>
      <trkpt lat="0.0018" lon="0.0045"></trkpt>
      <trkpt lat="0.0026" lon="0.0047"></trkpt>
    </trkseg>
    <trkseg>
      <trkpt lat="0.0031" lon="0.0061"></trkpt>
      <trkpt lat="0.0034" lon="0.0066"></trkpt>
    </trkseg>
  </trk>
</gpx>
